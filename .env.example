# Local machine settings.
#
# Copy this file to `.env` (untracked) and fill in the values for this machine.
# Nothing here is committed; `.env` is ignored by Git.

# Address the local debug preview listens on and prints in its links.
# Use the address this machine is actually reachable at, for example its
# current ZeroTier / LAN address. `127.0.0.1` only works for the same host.
PREVIEW_HOST=127.0.0.1

# Optional: choose another disposable preview state directory.
# Defaults to `.local/discovery-preview-state`.
# PREVIEW_STATE=.local/discovery-preview-state

# Cloudflare API token used by the migration and maintenance tools.
# Requires explicit authorization before any request against a remote account.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
