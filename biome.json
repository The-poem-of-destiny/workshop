{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/dist",
      "!**/build",
      "!data_backup",
      "!apps/tavern-client/data",
      "!packages/content/src/ejs-checker/vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**/src/**/*.{ts,js,mjs}",
        "packages/**/src/**/*.{ts,js,mjs}",
        "tools/**/*.mjs",
        "!**/*.{test,spec}.{ts,js,mjs}",
        "!tools/**/test*.mjs",
        "!tools/e2e-local.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 40 } },
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 120, "skipBlankLines": true } }
          },
          "style": {
            "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 600, "skipBlankLines": true } }
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/**/*.tsx", "packages/**/src/**/*.tsx", "!**/*.{test,spec}.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 60 } },
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 300, "skipBlankLines": true } }
          },
          "style": {
            "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 700, "skipBlankLines": true } }
          }
        }
      }
    },
    {
      "includes": ["apps/worker/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/worker/src/**",
                      "**/src/storage/**",
                      "**/src/http/**",
                      "@workshop/worker",
                      "@workshop/worker/**"
                    ],
                    "message": "Web must use shared contracts or HTTP, not Worker implementation imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workshop/contracts",
                      "@workshop/contracts/**",
                      "@workshop/content",
                      "@workshop/content/**",
                      "**/contracts/src/**",
                      "**/content/src/**",
                      "**/apps/**"
                    ],
                    "message": "Pure domain rules must not depend on contracts, content or applications."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
