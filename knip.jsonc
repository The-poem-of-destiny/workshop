{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "rules": { "cycles": "error" },
  "ignoreIssues": {
    // Cloudflare Worker / Durable Object / WorkerEntrypoint runtime exports.
    "apps/worker/src/index.ts": ["exports"],
    // Standalone esbuild IIFE bundle entry (`window.PoemEjsChecker`).
    "packages/content/src/ejs-checker/browser.mjs": ["exports"],
    // Handwritten ambient declarations mirroring packages/content/src/index.mjs.
    "packages/content/src/index.d.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/migrate/full-r2.mjs",
        "tools/migrate/full-transform-content.mjs",
        "tools/dev/load-legacy-fixture.mts"
      ],
      "project": ["tools/**/*.{mjs,mts}"],
      // Recursive `pnpm -r --if-present typecheck` is a workspace script, not
      // an npm executable; `ffmpeg` is an optional host tool for preview fixtures.
      "ignoreBinaries": ["typecheck", "ffmpeg"]
    },
    "apps/worker": {
      "project": ["src/**/*.ts", "test/**/*.ts", "web/src/**/*.{ts,tsx,css}", "*.config.ts"],
      "wrangler": { "config": ["wrangler.jsonc"] },
      // Vite is nested, not at the workspace root. Its HTML entry and CSS imports
      // (including tailwindcss) must stay in the dependency graph.
      "vite": { "config": ["web/vite.config.ts"] },
      "vitest": { "config": ["vitest.config.ts"] }
    },
    "apps/tavern-client": {
      // esbuild entryPoints are constructed with path.join in scripts/build.mjs.
      // The test also builds src/lib.ts before importing its temporary output.
      "entry": ["src/index.ts", "src/lib.ts", "scripts/*.mjs", "test/*.test.mjs"],
      "project": ["src/**/*.ts", "scripts/*.mjs", "test/*.mjs"]
    },
    "packages/content": {
      // Package exports are discovered from package.json. These three extra
      // browser/Worker entries are built dynamically by scripts/build.mjs.
      "entry": [
        "src/ejs-checker/upload-worker.mjs",
        "src/ejs-checker/review-worker.mjs",
        "src/ejs-checker/browser.mjs",
        "scripts/*.mjs",
        "test/*.test.mjs"
      ],
      "project": ["src/**/*.mjs", "scripts/*.mjs", "test/*.mjs"]
    },
    "packages/contracts": {
      // Public entry is package.json exports/types, not every contract module.
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      // Vitest discovers domain tests in test/.
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
