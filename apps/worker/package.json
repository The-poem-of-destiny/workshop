{
  "name": "@workshop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --env staging",
    "deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging",
    "deploy:production": "wrangler deploy --config wrangler.jsonc --env production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "check:wrangler": "pnpm web:build && wrangler deploy --dry-run --config wrangler.jsonc --env staging",
    "cf-typegen": "wrangler types --config wrangler.jsonc"
  },
  "dependencies": {
    "@workshop/content": "workspace:*",
    "@workshop/contracts": "workspace:*",
    "@workshop/domain": "workspace:*",
    "hono": "^4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
