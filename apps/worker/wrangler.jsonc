{
  "name": "workshop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "DISCORD_CLIENT_ID": "1562466173268926575",
    "DISCORD_ALLOWED_GUILD_IDS": "1417861565679669272,1134557553011998840",
    // 鸽子窝 1417861565679669272：只校验公会；类脑 1134557553011998840：需要“已验证”身份组。
    "DISCORD_GUILD_ROLE_IDS": "1134557553011998840:1335363403870502912"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/client/*", "/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTENT_SERVICE",
        "class_name": "ContentService"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ContentService"]
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workshop-staging",
      "database_id": "7500b5f6-21a0-4dfd-9e16-0d9a4f9de476",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "workshop-client-staging"
    }
  ],
  "env": {
    "staging": {
      "name": "workshop-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://workshop-staging.poem-of-destiny.workers.dev",
        "PUBLIC_ORIGIN": "https://workshop-staging.poem-of-destiny.workers.dev",
        "DISCORD_CLIENT_ID": "1562466173268926575",
        "DISCORD_ALLOWED_GUILD_IDS": "1417861565679669272,1134557553011998840",
        // 鸽子窝 1417861565679669272：只校验公会；类脑 1134557553011998840：需要“已验证”身份组。
        "DISCORD_GUILD_ROLE_IDS": "1134557553011998840:1335363403870502912"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CONTENT_SERVICE",
            "class_name": "ContentService"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workshop-staging",
          "database_id": "7500b5f6-21a0-4dfd-9e16-0d9a4f9de476",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "workshop-client-staging"
        }
      ]
    },
    "production": {
      "name": "workshop",
      "vars": {
        "ALLOWED_ORIGINS": "https://workshop.poem-of-destiny.workers.dev",
        "PUBLIC_ORIGIN": "https://workshop.poem-of-destiny.workers.dev",
        "DISCORD_CLIENT_ID": "",
        "DISCORD_ALLOWED_GUILD_IDS": "",
        "DISCORD_GUILD_ROLE_IDS": ""
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CONTENT_SERVICE",
            "class_name": "ContentService"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workshop-prod",
          "database_id": "ebf2963e-dcd7-43db-93b0-4d1cff524656",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "workshop-client-prod"
        }
      ]
    }
  }
}
