{
  "name": "workshop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/client/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workshop-staging",
      "database_id": "7500b5f6-21a0-4dfd-9e16-0d9a4f9de476",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "workshop-client-staging"
    }
  ],
  "env": {
    "staging": {
      "name": "workshop-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workshop-staging",
          "database_id": "7500b5f6-21a0-4dfd-9e16-0d9a4f9de476",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "workshop-client-staging"
        }
      ]
    },
    "production": {
      "name": "workshop",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workshop-prod",
          "database_id": "ebf2963e-dcd7-43db-93b0-4d1cff524656",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "workshop-client-prod"
        }
      ]
    }
  }
}
