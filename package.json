{
  "name": "poem-of-destiny-workshop-scripts",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production && node scripts/build-workshop-legacy-shim.mjs",
    "watch": "node scripts/build-workshop-legacy-shim.mjs && webpack --config webpack.config.cjs --mode development --watch",
    "check": "pnpm check:workspace && pnpm -r --if-present typecheck && pnpm -r --if-present test && pnpm check:schema && node tools/migrate/test.mjs && node tools/migrate/test-from-sql.mjs && pnpm --filter @workshop/worker check:wrangler",
    "check:workspace": "node tools/check-workspace.mjs",
    "check:schema": "node tools/check-schema.mjs",
    "worker:test": "pnpm --filter @workshop/worker test",
    "e2e:local": "node tools/e2e-local.mjs",
    "load:local": "node tools/migrate/load-local.mjs",
    "check:workshop-bundles": "node scripts/check-workshop-bundles.mjs"
  },
  "devDependencies": {
    "ts-loader": "9.5.2",
    "typescript": "5.9.2",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1"
  }
}
