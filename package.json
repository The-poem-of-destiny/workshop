{
  "name": "poem-of-destiny-workshop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm --filter @workshop/worker web:build",
    "dev": "pnpm --filter @workshop/worker dev",
    "preview:debug": "node tools/preview-debug.mjs",
    "check": "pnpm check:workspace && biome ci . --error-on-warnings && pnpm -r --if-present typecheck && pnpm -r --if-present test && pnpm check:schema && node tools/migrate/test.mjs && node tools/migrate/test-from-sql.mjs && node tools/backup/test.mjs && pnpm --filter @workshop/worker check:wrangler && pnpm check:bundle",
    "check:workspace": "node tools/check-workspace.mjs",
    "check:schema": "node tools/check-schema.mjs",
    "check:bundle": "node tools/check-bundle-size.mjs",
    "worker:test": "pnpm --filter @workshop/worker test",
    "e2e:local": "node tools/e2e-local.mjs",
    "load:local": "node tools/migrate/load-local.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
